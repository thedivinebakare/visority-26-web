{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/:code([Vv][Ss][Rr][0-9]{3})",
      "destination": "/api/ambassador?code=:code"
    },
    {
      "source": "/:code([Vv][Ss][Rr][0-9]{3})/",
      "destination": "/api/ambassador?code=:code"
    }
  ]
}
